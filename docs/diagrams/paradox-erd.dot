  edge [fontname="Helvetica", fontsize=10, color="#334155", penwidth=1.2, dir=both, arrowtail=crow, arrowhead=tee];
  subgraph cluster_systems {
    label="Systems"; style="dashed"; color="#1E3A8A"; fontcolor="#1E3A8A";
    system [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" color="#1E3A8A"><tr><td bgcolor="#1E3A8A" colspan="2"><font color="#FFFFFF"><b>system</b></font></td></tr><tr><td align="left"><font point-size="9">PK</font></td><td align="left">id</td></tr></table>>];
    job [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" color="#1E3A8A"><tr><td bgcolor="#1E3A8A" colspan="2"><font color="#FFFFFF"><b>job</b></font></td></tr><tr><td align="left"><font point-size="9">PK</font></td><td align="left">id</td></tr><tr><td align="left"><font point-size="9">FK</font></td><td align="left">system_id</td></tr></table>>];
  }
  subgraph cluster_intake {
    label="Intake"; style="dashed"; color="#B45309"; fontcolor="#B45309";
    queue_request [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" color="#B45309"><tr><td bgcolor="#B45309" colspan="2"><font color="#FFFFFF"><b>queue_request</b></font></td></tr><tr><td align="left"><font point-size="9">PK FK</font></td><td align="left">system_id</td></tr><tr><td align="left"><font point-size="9">PK</font></td><td align="left">request_id</td></tr><tr><td align="left"><font point-size="9">FK</font></td><td align="left">run_id</td></tr></table>>];
  }
  subgraph cluster_runs {
    label="Runs"; style="dashed"; color="#0E7490"; fontcolor="#0E7490";
    run [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" color="#0E7490"><tr><td bgcolor="#0E7490" colspan="2"><font color="#FFFFFF"><b>run</b></font></td></tr><tr><td align="left"><font point-size="9">PK</font></td><td align="left">id</td></tr><tr><td align="left"><font point-size="9">FK</font></td><td align="left">job_id</td></tr></table>>];
    attempt [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" color="#0E7490"><tr><td bgcolor="#0E7490" colspan="2"><font color="#FFFFFF"><b>attempt</b></font></td></tr><tr><td align="left"><font point-size="9">PK</font></td><td align="left">id</td></tr><tr><td align="left"><font point-size="9">FK</font></td><td align="left">run_id</td></tr></table>>];
  }
  subgraph cluster_operation {
    label="Operation"; style="dashed"; color="#64748B"; fontcolor="#64748B";
    run_action [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" color="#64748B"><tr><td bgcolor="#64748B" colspan="2"><font color="#FFFFFF"><b>run_action</b></font></td></tr><tr><td align="left"><font point-size="9">PK</font></td><td align="left">id</td></tr><tr><td align="left"><font point-size="9">FK</font></td><td align="left">run_id</td></tr><tr><td align="left"><font point-size="9">FK</font></td><td align="left">by_system_id <font point-size="8">(optional)</font></td></tr></table>>];
  }
  job -> system [];
  queue_request -> system [];
  queue_request -> run [arrowtail=tee, xlabel="0..1"];
  run -> job [];
  attempt -> run [];
  run_action -> run [];
  run_action -> system [style=dashed];
}
