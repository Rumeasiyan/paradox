// PARADOX architecture, reference deployment (PRD Annex B).
// Render: dot -Tsvg paradox-architecture.dot -o paradox-architecture.svg
// Link numbers must match the table in docs/prd.md, Annex B.
digraph paradox {
  rankdir=TB;
  newrank=true;
  nodesep=0.5;
  ranksep=0.7;
  fontname="Helvetica";
  node [fontname="Helvetica", fontsize=11, shape=box, style="rounded,filled", fillcolor="#FFFFFF", color="#1E3A8A", penwidth=1.4];
  edge [fontname="Helvetica", fontsize=12, fontcolor="#0F172A", color="#334155", penwidth=1.3];

  subgraph cluster_deploy {
    label="Deploy time (deployment repository)";
    style="dashed"; color="#64748B"; fontcolor="#334155";
    deployrepo [label=<<b>Deployment repository</b><br/><font point-size="9">real settings, PARADOX private key<br/>schedule files, public keys</font>>];
  }

  subgraph cluster_server {
    label="Shared server (Docker); open: 443"; labeljust="l";
    style="filled"; fillcolor="#EEF2FF"; color="#1E3A8A"; fontcolor="#1E3A8A";

    proxy [label=<<b>Reverse proxy</b><br/><font point-size="9">HTTPS 443<br/>only /api/jobs is public</font>>];

    schedules [shape=folder, label=<<b>Systems folder</b><br/><font point-size="9">per system: schedules.yaml, system.pub<br/>read-only</font>>];

    paradox [fillcolor="#1E3A8A", fontcolor="#FFFFFF", color="#1E3A8A", label=<<b>PARADOX</b><br/><font point-size="9">never sleeps<br/>timetable, queue API, runner</font>>];

    sablier [label=<<b>Sablier</b><br/><font point-size="9">starts and stops containers<br/>on demand</font>>];

    pgbouncer [label=<<b>PgBouncer</b><br/><font point-size="9">connection pool<br/>session mode, 2 connections</font>>];
    db [shape=cylinder, label=<<b>Postgres</b><br/><font point-size="9">PARADOX database<br/>timetable, queue, run records</font>>];

    subgraph cluster_systems {
      label="Systems on this server (sleep when idle)"; labelloc="b";
      style="dashed"; color="#1E3A8A"; fontcolor="#1E3A8A"; fillcolor="#FFFFFF";
      citadel [label=<<b>CITADEL</b><br/><font point-size="9">example system<br/>answers /jobs/&lt;name&gt;</font>>];
      others [label=<<b>Other systems</b><br/><font point-size="9">same pattern</font>>];
    }
  }

  outside [label=<<b>Outside system</b><br/><font point-size="9">other hosting, always on<br/>answers /jobs/&lt;name&gt;</font>>, color="#64748B"];
  monitor [label=<<b>Monitor</b><br/><font point-size="9">push monitor<br/>(Uptime Kuma or any push URL)</font>>];

  { rank=same; deployrepo; outside; }
  { rank=same; proxy; schedules; paradox; sablier; }
  { rank=same; pgbouncer; citadel; others; }
  { rank=same; db; monitor; }

  deployrepo -> schedules [label=" 1 ", style=dashed];
  deployrepo -> paradox [label=" 2 ", style=dashed];
  schedules -> paradox [label=" 3 "];
  citadel -> paradox [label=" 4 ", color="#F59E0B", fontcolor="#B45309", penwidth=2.2];
  outside -> proxy [label=" 4 ", color="#F59E0B", fontcolor="#B45309", penwidth=2.2];
  proxy -> paradox [label=" 4 ", color="#F59E0B", fontcolor="#B45309", penwidth=2.2];
  paradox -> pgbouncer [label=" 5 "];
  pgbouncer -> db [label=" 6 "];
  paradox -> sablier [label=" 7 "];
  sablier -> citadel [label=" 8 "];
  sablier -> others [label=" 8 "];
  paradox -> citadel [label=" 9 ", color="#F59E0B", fontcolor="#B45309", penwidth=2.2];
  paradox -> outside [label=" 9 ", color="#F59E0B", fontcolor="#B45309", penwidth=2.2];
  paradox -> monitor [label=" 10 ", style=dashed];
}
